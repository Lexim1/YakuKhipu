# Copiar como .env.local (no se sube) y ajustar.

# Origen de la API. VACÍO = mismo origen (recomendado): en desarrollo Vite reenvía /api y /health
# a VITE_PROXY_API, y en la nube lo hace nginx (deploy/). Solo poner una URL si la API está en otro
# dominio y el ingreso es con contraseña; el ingreso institucional (OIDC) exige el mismo origen.
VITE_API_URL=

# Dirección del backend al que Vite reenvía /api en desarrollo.
VITE_PROXY_API=http://localhost:8000

# true: usa los ejemplos simulados de src/mocks (solo desarrollo). false: consulta la API real.
VITE_USAR_EJEMPLOS=false
